"""A small multi-language monorepo under Bazel: Go, Python and C++ targets sharing one protobuf schema,
built hermetically with a remote cache on Google Cloud Storage. See README.md."""

module(name = "fr_monorepo", version = "0.1.0")

bazel_dep(name = "rules_go", version = "0.65.0")
bazel_dep(name = "gazelle", version = "0.54.0")
bazel_dep(name = "rules_python", version = "2.4.5")
bazel_dep(name = "rules_cc", version = "0.2.27")
bazel_dep(name = "protobuf", version = "36.2")
bazel_dep(name = "platforms", version = "1.1.0")
# BuildBuddy remote execution: a Linux x86_64 execution platform and a C++ toolchain for its executors.
bazel_dep(name = "toolchains_buildbuddy", version = "0.0.4")

buildbuddy = use_extension("@toolchains_buildbuddy//:extensions.bzl", "buildbuddy")
buildbuddy.platform(buildbuddy_container_image = "UBUNTU24_04_IMAGE")
use_repo(buildbuddy, "buildbuddy_toolchain")

# Go: toolchain + modules from go.mod
go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.26.5")
# A Linux SDK too, so Go tools can run on the remote executors when --config=remote sets the host platform.
go_sdk.download(
    goarch = "amd64",
    goos = "linux",
    version = "1.26.5",
)

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(go_deps, "org_golang_google_protobuf")

# Python: hermetic interpreter + pinned pip deps
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(python_version = "3.12", is_default = True)

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    # Resolve wheels from the index for every platform the hashed lock allows, not just the host's, so the
    # same targets build on BuildBuddy's Linux executors from a Mac.
    experimental_index_url = "https://pypi.org/simple",
    hub_name = "pypi",
    python_version = "3.12",
    requirements_lock = "//python:requirements.txt",
    # The host only, by default; name the executor platform too.
    target_platforms = [
        "linux_x86_64",
        "osx_aarch64",
    ],
)
use_repo(pip, "pypi")
