load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "bepdog_lib",
    srcs = ["main.go"],
    importpath = "github.com/twwalsh/bazel-monorepo/go/bepdog",
)

go_binary(
    name = "bepdog",
    embed = [":bepdog_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "bepdog_test",
    srcs = ["main_test.go"],
    embed = [":bepdog_lib"],
)
