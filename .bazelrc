# Hermetic, reproducible, quiet.
common --enable_bzlmod
build --incompatible_strict_action_env
build --show_timestamps
test --test_output=errors

# Remote cache on Google Cloud Storage. Bazel speaks to the bucket as an HTTP cache; credentials come from
# gcloud application-default login locally and from Workload Identity Federation in CI.
#   bazel build --config=gcs //...
build:gcs --remote_cache=https://storage.googleapis.com/nth-victory-240719-bazel-cache
build:gcs --google_default_credentials
build:gcs --remote_upload_local_results

# Remote EXECUTION on BuildBuddy: every action runs on their Linux x86_64 executors, results stream to the
# BuildBuddy UI (per-action timings, cache hit rates, test logs). The API key is NOT here: it lives in the
# gitignored user.bazelrc locally (build --remote_header=x-buildbuddy-api-key=…) and in a CI secret.
#   bazel test --config=remote //...
build:remote --remote_executor=grpcs://remote.buildbuddy.io
build:remote --remote_cache=grpcs://remote.buildbuddy.io
build:remote --bes_backend=grpcs://remote.buildbuddy.io
build:remote --bes_results_url=https://app.buildbuddy.io/invocation/
build:remote --host_platform=@buildbuddy_toolchain//:platform_linux_x86_64
build:remote --platforms=@buildbuddy_toolchain//:platform_linux_x86_64
build:remote --extra_execution_platforms=@buildbuddy_toolchain//:platform_linux_x86_64
build:remote --extra_toolchains=@buildbuddy_toolchain//:ubuntu_cc_toolchain
build:remote --remote_timeout=10m
build:remote --jobs=50
build:remote --remote_download_toplevel
# Do not configure the host's own C++ toolchain (on a Mac that is Apple clang, which would be scheduled on a
# darwin executor the pool does not have); the BuildBuddy cc toolchain is the only one for --config=remote.
build:remote --repo_env=BAZEL_DO_NOT_DETECT_CPP_TOOLCHAIN=1

try-import %workspace%/user.bazelrc

# CI: no sandboxing surprises on the runner, machine-readable timings, fail fast.
build:ci --noshow_progress
build:ci --announce_rc
build:ci --remote_download_toplevel
test:ci --test_output=errors
